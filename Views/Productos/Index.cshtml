@model IEnumerable<CRUDProductos.Models.Producto>

@{
    ViewData["Title"] = "Productos";
}

<div class="container py-5">

    <!-- ============================================= -->
    <!-- ENCABEZADO -->
    <!-- ============================================= -->

    <div class="row align-items-center mb-4">

        <div class="col-md-8">

            <h1 class="fw-bold mb-2">

                <i class="bi bi-box-seam-fill me-2"></i>

                Productos

            </h1>

            <p class="text-muted mb-0">

                Administración y gestión de productos

            </p>

        </div>

        <div class="col-md-4 text-md-end mt-3 mt-md-0">

            <a asp-action="Create"
               class="btn btn-primary btn-lg shadow-sm">

                <i class="bi bi-plus-circle-fill me-2"></i>

                Nuevo Producto

            </a>

        </div>

    </div>


    <!-- ============================================= -->
    <!-- TARJETA -->
    <!-- ============================================= -->

    <div class="card border-0 shadow-lg">

        <!-- CABECERA -->

        <div class="card-header bg-primary text-white py-3">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <h5 class="mb-0 fw-bold">

                        <i class="bi bi-list-ul me-2"></i>

                        Lista de Productos

                    </h5>

                </div>

                <div class="col-md-6 text-md-end mt-2 mt-md-0">

                    <span class="badge bg-light text-primary fs-6">

                        <i class="bi bi-boxes me-1"></i>

                        @Model.Count() productos

                    </span>

                </div>

            </div>

        </div>


        <!-- CONTENIDO -->

        <div class="card-body p-0">

            @if (!Model.Any())
            {
                <div class="text-center py-5 px-3">

                    <div class="display-1 mb-3">

                        <i class="bi bi-box-seam"></i>

                    </div>

                    <h4 class="fw-bold text-dark">

                        No hay productos registrados

                    </h4>

                    <p class="text-muted">

                        Comienza agregando un nuevo producto.

                    </p>

                    <a asp-action="Create"
                       class="btn btn-primary">

                        <i class="bi bi-plus-circle-fill me-2"></i>

                        Crear Producto

                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>

                            <tr>

                                <th class="text-center">
                                    #
                                </th>

                                <th>
                                    Producto
                                </th>

                                <th>
                                    Descripción
                                </th>

                                <th class="text-end">
                                    Precio
                                </th>

                                <th class="text-center">
                                    Stock
                                </th>

                                <th class="text-center">
                                    Acciones
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="text-center">

                                        <span class="badge bg-secondary">

                                            @item.Id

                                        </span>

                                    </td>

                                    <td>

                                        <span class="fw-bold">

                                            <i class="bi bi-box-fill text-primary me-2"></i>

                                            @item.Nombre

                                        </span>

                                    </td>

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(item.Descripcion))
                                        {
                                            <span class="text-muted fst-italic">

                                                Sin descripción

                                            </span>
                                        }
                                        else
                                        {
                                            @item.Descripcion
                                        }

                                    </td>

                                    <td class="text-end">

                                        <span class="fw-bold text-success">

                                            <i class="bi bi-currency-dollar"></i>

                                            @item.Precio.ToString("N2")

                                        </span>

                                    </td>

                                    <td class="text-center">

                                        @if (item.Stock > 10)
                                        {
                                            <span class="badge bg-success rounded-pill px-3">

                                                <i class="bi bi-check-circle-fill me-1"></i>

                                                @item.Stock

                                            </span>
                                        }
                                        else if (item.Stock > 0)
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3">

                                                <i class="bi bi-exclamation-triangle-fill me-1"></i>

                                                @item.Stock

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger rounded-pill px-3">

                                                <i class="bi bi-x-circle-fill me-1"></i>

                                                Agotado

                                            </span>
                                        }

                                    </td>

                                    <td class="text-center">

                                        <div class="btn-group">

                                            <a asp-action="Details"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-info"
                                               title="Ver detalles">

                                                <i class="bi bi-eye-fill"></i>

                                            </a>

                                            <a asp-action="Edit"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-warning"
                                               title="Editar">

                                                <i class="bi bi-pencil-fill"></i>

                                            </a>

                                            <a asp-action="Delete"
                                               asp-route-id="@item.Id"
                                               class="btn btn-outline-danger"
                                               title="Eliminar">

                                                <i class="bi bi-trash-fill"></i>

                                            </a>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>


        <!-- FOOTER -->
        @if (Model.Any())
        {
            <div class="card-footer bg-light">

                <div class="d-flex justify-content-between align-items-center">

                    <small class="text-muted">

                        <i class="bi bi-database-fill me-1"></i>

                        Información almacenada en MySQL

                    </small>

                    <a asp-action="Create"
                       class="btn btn-sm btn-primary">

                        <i class="bi bi-plus-lg me-1"></i>

                        Agregar producto

                    </a>

                </div>

            </div>
        }
    </div>
</div>