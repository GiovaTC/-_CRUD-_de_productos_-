<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CRUD Productos</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- CSS personalizado -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/CRUDProductos.styles.css"
          asp-append-version="true" />

</head>

<body>

    <!-- ================================================= -->
    <!-- NAVBAR -->
    <!-- ================================================= -->

    <nav class="navbar navbar-expand-lg navbar-dark navbar-crud shadow">

        <div class="container">

            <a class="navbar-brand fw-bold"
               asp-controller="Productos"
               asp-action="Index">

                <i class="bi bi-box-seam-fill me-2 icon-brand"></i>
                CRUD Productos

            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#menuPrincipal">

                <span class="navbar-toggler-icon"></span>

            </button>

            <div class="collapse navbar-collapse"
                 id="menuPrincipal">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Productos"
                           asp-action="Index">

                            <i class="bi bi-house-fill me-1"></i>
                            Inicio

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Productos"
                           asp-action="Index">

                            <i class="bi bi-grid-fill me-1"></i>
                            Productos

                        </a>

                    </li>

                    <li class="nav-item">

                        <a class="nav-link"
                           asp-controller="Productos"
                           asp-action="Create">

                            <i class="bi bi-plus-circle-fill me-1"></i>
                            Nuevo Producto

                        </a>

                    </li>

                </ul>

                <span class="navbar-text">

                    <i class="bi bi-database-fill me-1"></i>
                    MySQL

                </span>

            </div>

        </div>

    </nav>


    <!-- ================================================= -->
    <!-- CONTENIDO -->
    <!-- ================================================= -->

    <main>

        @RenderBody()

    </main>


    <!-- ================================================= -->
    <!-- FOOTER -->
    <!-- ================================================= -->

    <footer class="footer-crud">

        <div class="container">

            <div class="row align-items-center">

                <div class="col-md-6">

                    <div class="footer-title">

                        <i class="bi bi-box-seam-fill me-2"></i>
                        CRUD Productos

                    </div>

                    <small>
                        ASP.NET Core MVC + MySQL
                    </small>

                </div>

                <div class="col-md-6 text-md-end">

                    <small>
                        © 2026 CRUD Productos
                    </small>

                </div>

            </div>

        </div>

    </footer>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body> 
</html>